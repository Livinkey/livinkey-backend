# DATAGASE CONFIGURATION
DB_HOST=
DB_PORT=56108
DB_NAME=
DB_USER=
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=90d

# LIVINKEY EMAIL CONFIGURATION
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# LIVINKEY CLOUDINARY CONFIGURATION
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================
# FIREBASE (Push Notifications)
# ============================================================
ENABLE_PUSH_NOTIFICATIONS=true
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ============================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================

# Merchant UPI ID (Your business UPI ID)
MERCHANT_UPI_ID=
MERCHANT_NAME=Livinkey
MERCHANT_CODE=LIVINKEY

# Enable/Disable Payment Gateway
ENABLE_PAYMENT_GATEWAY=true

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=

# PayU
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENVIRONMENT=

# App URL (for payment callbacks)
APP_URL=

# ------------------------------------------------------------
# BIGTOS (WhatsApp / SMS)  – see docs/BIGTOS_SETUP.md
# ------------------------------------------------------------
BIGTOS_API_KEY=
# API base URL (default shown; change only if Bigtos gives you another)
BIGTOS_BASE_URL=https://www.cp.bigtos.com/api/v1
# Optional: URL of a Bigtos SMS API (same fields as sendmessage). Leave blank to skip the SMS step.
BIGTOS_SMS_ENDPOINT=
# Approved WhatsApp TEMPLATE NAMES (needed to message people who have not written to you in the last 24h)
BIGTOS_TEMPLATE_LANGUAGE=en
BIGTOS_OTP_TEMPLATE=
BIGTOS_BILL_TEMPLATE=
BIGTOS_FINE_TEMPLATE=
BIGTOS_EFRRO_TEMPLATE=
BIGTOS_CUSTOM_TEMPLATE=
BIGTOS_MAINTENANCE_TEMPLATE=
# Set to true only if your OTP template has a 2nd variable for the purpose (Login / Forgot Password)
BIGTOS_OTP_PURPOSE_VAR=false
# Incoming-message webhook is protected by this secret: https://<api>/api/webhooks/bigtos/whatsapp?token=<secret>
BIGTOS_WEBHOOK_SECRET=
# Set to false only for local testing
BIGTOS_VALIDATE_WEBHOOK=true
# Extra hosts the admin attachment proxy may download from (comma separated, optional)
BIGTOS_MEDIA_HOSTS=
# Max wait for Bigtos to answer (ms)
BIGTOS_TIMEOUT_MS=30000
# true = log the full body of every incoming webhook (turn on while testing, then off)
BIGTOS_WEBHOOK_DEBUG=false

# ------------------------------------------------------------
# WHATSAPP BEHAVIOUR
# ------------------------------------------------------------
# Set to "true" if you want automatic reply when user messages you
WHATSAPP_AUTO_REPLY=
WHATSAPP_AUTO_REPLY_TEXT=

# ---- Added during security hardening ----
# Public URLs used in emails / payment callbacks (must be correct!)
PUBLIC_API_URL=https://api.livinkey.com
WEBSITE_URL=https://livinkey.com
ADMIN_URL=https://admin.livinkey.com
APP_STORE_URL=https://play.google.com/store/apps/details?id=com.livinkey.app
# Extra browser origins allowed to call the API (comma separated, optional)
CORS_ORIGINS=
# MySQL connection pool size
DB_POOL_LIMIT=15

# ------------------------------------------------------------
# Messaging delivery chain: WhatsApp -> SMS -> e-mail   (see docs/BIGTOS_SETUP.md)
# ------------------------------------------------------------
# Order / on-off switch of the channels (remove one to disable it). Default: whatsapp,sms,email
MESSAGING_CHANNELS=whatsapp,sms,email
# E-mail copy next to WhatsApp (Bigtos cannot confirm a number is on WhatsApp):
#   always   = every message also goes to e-mail (default)
#   critical = only OTP, passwords/welcome, bills and fines
#   fallback = e-mail only when WhatsApp/SMS fail (old behaviour)
MESSAGING_EMAIL_COPY=critical
# Country code used for numbers saved without one (digits only, e.g. 91 for India, 255 for Tanzania)
DEFAULT_COUNTRY_CODE=91

# Smart links in WhatsApp / e-mail messages expire after this many hours
LINK_TTL_HOURS=72
# Time zone used when times are written into messages
APP_TIMEZONE=Asia/Kolkata
